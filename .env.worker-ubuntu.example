# Copy this to .env on an Ubuntu worker PC.
# The real .env is gitignored.

# Control plane address reachable over the shared network/Tailscale.
BICLOUD_CONTROL_PLANE_URL=http://CONTROL_PLANE_IP:8080

# Must match bicloud.api-key on the control plane and this worker.
BICLOUD_CONTROL_PLANE_API_KEY=CHANGE_ME_WORKER_CP_KEY

# Must match bicloud.gateway.api-key on the control plane and all gateways.
BICLOUD_GATEWAY_API_KEY=CHANGE_ME_GATEWAY_KEY

# Ubuntu compose defaults to tcp://bicloud-socket-proxy:2375.
# BICLOUD_GATEWAY_DOCKER_HOST=tcp://bicloud-socket-proxy:2375
