# Copy this to .env and fill in the values. .env is gitignored.

# Control plane address reachable from all machines (e.g. a Tailscale IP)
BICLOUD_CONTROL_PLANE_URL=http://CONTROL_PLANE_IP:8080

# Gateway service key - must be the same on all gateways and the CP
BICLOUD_GATEWAY_API_KEY=CHANGE_ME

# Optional: Docker daemon endpoint used by the gateway container.
# Root Windows compose defaults to tcp://host.docker.internal:2375.
# Ubuntu socket-proxy compose defaults to tcp://bicloud-socket-proxy:2375.
# BICLOUD_GATEWAY_DOCKER_HOST=tcp://host.docker.internal:2375
